# Public base URL of the site (used for canonical URLs, sitemap, OG tags).
# Local: http://localhost:3000
# Production (Vercel): https://inferra.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google Search Console verification (meta-tag method).
# In GSC choose "HTML tag" verification and copy ONLY the content="..." token
# (not the whole <meta> tag) here. Leave empty to emit no verification tag.
# Set this in Vercel's Environment Variables for production.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX).
# Leave empty to disable analytics entirely (no script is injected).
NEXT_PUBLIC_GA_ID=

# Google AdSense publisher ID (e.g. ca-pub-XXXXXXXXXXXXXXXX).
# Leave empty to disable ads (no AdSense script or slots render).
NEXT_PUBLIC_ADSENSE_CLIENT=
